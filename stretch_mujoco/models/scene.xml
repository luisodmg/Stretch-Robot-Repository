<mujoco model="stretch scene">
  <include file="stretch.xml" />
  <include file="docking_station.xml" />
  <statistic center="0 0 .75" extent="1.2" meansize="0.05" />
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-120" elevation="-20" />
  </visual>
  <asset>
    <material name="floor" rgba=".1 .1 .1 1" reflectance="0.1" />
    <texture type="2d" name="wood" file="wood.png" />
    <material name="wood" texture="wood" />
    <material name="object" rgba=".2 .2 .2 1" />
    <material name="medicine_box_body" rgba=".2 .35 .8 1" />
    <material name="glass_body" rgba=".8 .2 .2 1" />
    <material name="tissue_body" rgba=".95 .95 .95 1" />
    <texture type="skybox" builtin="gradient" rgb1="0.44 0.80 1.00" rgb2="1 1 1" width="512" height="3072" />
    <!-- Stretch Assist object markers as textured planes. A single textured box
         renders far crisper than ~16 floating black tiles, so the markers can be
         small (~5 cm) and still decode. texuniform="false" maps the full texture
         once onto each box face. Regenerate PNGs with tools/gen_aruco_textures.py
         and resize the marker boxes with tools/regen_aruco_textured.py. -->
    <texture type="2d" name="stretch_assist_aruco_0" file="stretch_assist_aruco_0.png" />
    <material name="stretch_assist_aruco_0_mat" texture="stretch_assist_aruco_0" texuniform="false" texrepeat="1 1" />
    <texture type="2d" name="stretch_assist_aruco_1" file="stretch_assist_aruco_1.png" />
    <material name="stretch_assist_aruco_1_mat" texture="stretch_assist_aruco_1" texuniform="false" texrepeat="1 1" />
    <texture type="2d" name="stretch_assist_aruco_2" file="stretch_assist_aruco_2.png" />
    <material name="stretch_assist_aruco_2_mat" texture="stretch_assist_aruco_2" texuniform="false" texrepeat="1 1" />
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="floor" />
    <!-- Table placed to the robot's right (-Y). Stretch's arm extends to the
         -Y side at the base x, so objects must sit on this side to be grasped.
         The robot drives forward along y~0 without colliding with the table. -->
    <body name="table" pos="0.35 -0.80 0.3">
      <geom type="box" size="0.30 0.20 0.3" mass="1" material="wood" />
    </body>
    <body name="medicine_box" pos="0.20 -0.70 0.636">
      <freejoint />
      <geom type="box" size=".045 .035 .035" mass=".3" material="medicine_box_body" />
      <geom name="medicine_box_aruco_0_marker" type="box" size="0.02500 0.02500 0.001" pos="0 0 0.03700" material="stretch_assist_aruco_0_mat" contype="0" conaffinity="0" />
    </body>
    <body name="glass" pos="0.35 -0.70 0.646">
      <freejoint />
      <geom type="cylinder" size=".015 .045" mass=".12" material="glass_body" condim="6" friction="1.5 0.1 0.01" />
      <geom name="glass_aruco_1_marker" type="box" size="0.01500 0.01500 0.001" pos="0 0 0.04700" material="stretch_assist_aruco_1_mat" contype="0" conaffinity="0" />
    </body>
    <body name="tissue" pos="0.50 -0.70 0.613">
      <freejoint />
      <geom type="box" size=".055 .025 .012" mass=".1" material="tissue_body" />
      <geom name="tissue_aruco_2_marker" type="box" size="0.02500 0.02500 0.001" pos="0 0 0.01400" material="stretch_assist_aruco_2_mat" contype="0" conaffinity="0" />
    </body>
  </worldbody>
</mujoco>